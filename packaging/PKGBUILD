pkgname=cloud-tasks
pkgver=0.2.0
pkgrel=1
pkgdesc='Unified iCloud and Google tasks with a native GTK app'
arch=('x86_64' 'aarch64')
makedepends=('rust' 'cargo' 'git')
url='https://github.com/ferdousbhai/cloud-tasks'
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita')
optdepends=('icloud-session: shared Apple sign-in' 'xdg-terminal-exec: sign-in from the app')
replaces=('icloud-reminders')
conflicts=('icloud-reminders')
# Run makepkg from packaging/ in a checked-out release tree.
source=()
sha256sums=()
build() {
  "$startdir/../bin/build-icloud"
}
check() {
  cd "$startdir/.."
  cargo test --locked --manifest-path icloud/Cargo.toml
  python -m unittest discover -s tests
}
package() {
  cd "$startdir/.."
  install -d "$pkgdir/usr/lib/cloud-tasks" "$pkgdir/usr/bin"
  install -Dm755 "${CARGO_TARGET_DIR:-icloud/target}/release/cloud-tasks-icloud" "$pkgdir/usr/lib/cloud-tasks/libexec/cloud-tasks-icloud"
  cp -r cloud_tasks bin "$pkgdir/usr/lib/cloud-tasks/"
  find "$pkgdir/usr/lib/cloud-tasks" -name __pycache__ -type d -exec rm -r {} +
  printf '%s\n' '#!/bin/sh' 'exec python /usr/lib/cloud-tasks/bin/cloud-tasks "$@"' > "$pkgdir/usr/bin/cloud-tasks"
  chmod 755 "$pkgdir/usr/bin/cloud-tasks"
  install -Dm644 data/com.ferdousbhai.cloudtasks.desktop "$pkgdir/usr/share/applications/com.ferdousbhai.cloudtasks.desktop"
  install -Dm644 data/systemd/cloud-tasks-background.service "$pkgdir/usr/lib/systemd/user/cloud-tasks-background.service"
  install -Dm644 data/systemd/cloud-tasks-background.timer "$pkgdir/usr/lib/systemd/user/cloud-tasks-background.timer"
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../cloud-tasks-background.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/cloud-tasks-background.timer"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/cloud-tasks/NOTICE"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/cloud-tasks/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/cloud-tasks/README.md"
}
