#!/bin/bash
# Verify exactly one published release on its native architecture. No automatic deletion.
set -euo pipefail
version=${1:?usage: bin/verify-release <version> [x86_64|aarch64]}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid version' >&2; exit 1; }
arch=${2:-$(uname -m)}
case "$arch" in x86_64|aarch64) ;; *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; esac
[[ $(uname -m) == "$arch" ]] || { echo 'A native runner is required.' >&2; exit 1; }
cd "$(dirname "$0")/.."
releases=https://github.com/ferdousbhai/cloud-tasks/releases/download/v$version
exec bin/arch-run env EXPECTED_VERSION="$version" EXPECTED_ARCH="$arch" \
  CLOUD_TASKS_RELEASES_URL="$releases" bash -euo pipefail -c '
    [[ $(uname -m) == "$EXPECTED_ARCH" ]]
    curl --fail --location --retry 3 "$CLOUD_TASKS_RELEASES_URL/install.sh" -o /tmp/install.sh
    bash /tmp/install.sh
    [[ $(pacman -Q cloud-tasks | cut -d" " -f2) == "$EXPECTED_VERSION-1" ]]
    [[ $(cloud-tasks --version) == "cloud-tasks $EXPECTED_VERSION" ]]
    test -x /usr/lib/cloud-tasks/libexec/cloud-tasks-icloud
    ldd /usr/lib/cloud-tasks/libexec/cloud-tasks-icloud > /tmp/provider-libraries
    ! grep -q "not found" /tmp/provider-libraries
    python -c "import gi; gi.require_version(\"Gtk\", \"4.0\"); gi.require_version(\"Adw\", \"1\"); from gi.repository import Adw, Gtk"
    test -f /usr/lib/systemd/user/cloud-tasks-background.timer
  '
